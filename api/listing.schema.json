{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shoofbait.com/api/listing.schema.json",
  "title": "شوف بيت listing (what a marketer sends us)",
  "description": "v0.1, 14 Oct 2026. The intake form, the n8n workflow and (later) the public API all send this, plus the 360° photos in shooting order. make-tour.py turns it into tours/<id>/tour.json.",
  "type": "object",
  "required": ["name", "city", "agent"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$", "description": "Optional. Made from the city/district/time if missing."},
    "name": {"type": "string", "maxLength": 120, "examples": ["شقة للبيع، حي النرجس"]},
    "type": {"type": "string", "examples": ["شقة", "فيلا", "تاون هاوس", "دور", "أرض", "مكتب"]},
    "city": {"type": "string", "examples": ["الرياض"]},
    "area": {"type": "string", "examples": ["شمال الرياض"]},
    "district": {"type": "string", "description": "Neighbourhood without the word حي.", "examples": ["النرجس"]},
    "price": {"type": "number", "minimum": 0, "description": "SAR."},
    "size": {"type": "number", "minimum": 0, "description": "Official area in m² (deed)."},
    "bedrooms": {"type": "integer", "minimum": 0},
    "bathrooms": {"type": "integer", "minimum": 0},
    "details": {
      "type": "object",
      "properties": {
        "floor": {"type": "string"}, "facade": {"type": "string"}, "streetWidth": {"type": "number"},
        "age": {"type": "integer", "minimum": 0, "description": "Years; 0 = new."}, "parking": {"type": "integer"},
        "extras": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pin": {"type": "object", "required": ["lat", "lng"], "properties": {"lat": {"type": "number"}, "lng": {"type": "number"}}},
    "agent": {
      "type": "object", "required": ["name", "whatsapp"],
      "properties": {"name": {"type": "string"}, "whatsapp": {"type": "string", "pattern": "^9665[0-9]{8}$"}}
    },
    "marketers": {
      "type": "array",
      "items": {"type": "object", "required": ["code", "name"],
        "properties": {"code": {"type": "string", "pattern": "^[a-z0-9_-]{2,32}$"}, "name": {"type": "string"}, "whatsapp": {"type": "string"}}}
    },
    "license": {"type": "object", "properties": {"fal": {"type": "string"}, "ad": {"type": "string"}}},
    "rooms": {
      "type": "array",
      "description": "One name per photo, in the same order as the photos (the shooting list). Optional: the AI names them when missing.",
      "items": {"type": "string"}, "examples": [["المدخل", "المجلس", "الصالة", "المطبخ", "غرفة النوم الرئيسية"]]
    }
  }
}
